{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Skill",
      "mcp__Claude_Preview"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(sftp:*)",
      "Bash(ftp:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(curl:* --upload-file*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(sudo:*)"
    ]
  }
}
